# Runtime
ENVIRONMENT=development
APP_ROLE=api
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/ai_tader.db
REDIS_URL=

# API security. Generate each value with: python -m app.security generate-key
# Put the SHA-256 hashes here, not the raw client keys.
API_KEY_HASHES=
ADMIN_KEY_HASHES=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60

# Trading safety: SIM is the safe default. LIVE also requires LIVE_TRADING_ENABLED,
# LIVE_CONFIRMATION_TOKEN_HASH, a matching X-Live-Confirmation header and a healthy broker.
TRADING_MODE=sim
BROKER_BACKEND=paper
LIVE_TRADING_ENABLED=false
TRADING_KILL_SWITCH=true
LIVE_CONFIRMATION_TOKEN_HASH=
WORKER_LIVE_CONFIRMATION_TOKEN=
TOKEN_ENCRYPTION_KEY=

# Deterministic risk policy
MAX_RISK_PER_TRADE=0.005
MAX_OPEN_POSITIONS=10
MAX_SECTOR_EXPOSURE=0.20
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_SPREAD_PCT=0.005
EARNINGS_BLACKOUT_DAYS=2
ATR_STOP_MULTIPLE=2.0
REWARD_RISK_RATIO=2.0
SIGNAL_MAX_AGE_MINUTES=90
MAX_MARKET_DATA_AGE_SECONDS=120
TRAILING_ACTIVATION_PCT=0.08
TRAILING_DISTANCE_ATR=2.0
TRAILING_STEP_ATR=0.5
TRADING_UNIVERSE_JSON=[]
AUTO_EXECUTE_SIGNALS=false
MARKET_HORIZON_MINUTES=60
MARKET_CANDLE_COUNT=120

# Azure OpenAI. Values are optional; the platform runs without AI when absent.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-5.4-mini
OPENAI_SOL_MODEL=gpt-5.4
AI_MONTHLY_BUDGET_DKK=1000
AI_SOL_MAX_RATIO=0.05
# Set these to the actual provider prices. AI stays disabled if rates are omitted.
AI_AZURE_MINI_INPUT_DKK_PER_M=0
AI_AZURE_MINI_OUTPUT_DKK_PER_M=0
AI_OPENAI_MINI_INPUT_DKK_PER_M=0
AI_OPENAI_MINI_OUTPUT_DKK_PER_M=0
AI_OPENAI_SOL_INPUT_DKK_PER_M=0
AI_OPENAI_SOL_OUTPUT_DKK_PER_M=0

# Saxo OpenAPI. Use SIM credentials first.
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=
SAXO_ACCOUNT_KEY=
SAXO_ACCESS_TOKEN=
SAXO_REFRESH_TOKEN=
SAXO_SIM_AUTH_BASE_URL=https://sim.logonvalidation.net
SAXO_LIVE_AUTH_BASE_URL=https://live.logonvalidation.net
SAXO_SIM_API_BASE_URL=https://gateway.saxobank.com/sim/openapi
SAXO_LIVE_API_BASE_URL=https://gateway.saxobank.com/openapi
